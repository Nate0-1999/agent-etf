{
  "name": "agent-etf-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "install:playwright": "playwright install --with-deps",
    "test:e2e": "playwright test --grep @core",
    "test:e2e:all": "playwright test",
    "test:e2e:headed": "playwright test --grep @core --headed",
    "test:e2e:update": "UPDATE_VERIFICATION_BASELINES=1 playwright test --grep @core",
    "test:e2e:report": "node tests/e2e/report-latest.mjs"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.53.1",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "typescript": "5.5.4"
  }
}
